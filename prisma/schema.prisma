generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LocationType {
  SHOWROOM
  WAREHOUSE
  STORAGE_ZONE
  CLEANING
  REPAIR
  TRANSIT
  OTHER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  DIRECTOR
  CASHIER
  SELLER
}

enum PublicationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PriceType {
  RENTAL
  SALE
}

enum InventoryTrackingMode {
  SERIALIZED
  BULK
}

enum ProductImageStatus {
  ACTIVE
  DELETED
}

enum StockAdjustmentType {
  INITIAL
  CORRECTION
}

enum ProductInstanceOperationalStatus {
  AVAILABLE
  PICKING
  READY_FOR_PICKUP
  RENTED
  RETURN_INSPECTION
  CLEANING
  REPAIR
  IN_TRANSFER
  SOLD
  WRITTEN_OFF
  LOST
}

enum ProductInstanceCondition {
  NEW
  EXCELLENT
  GOOD
  WORN
  DAMAGED
  UNUSABLE
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum ContactType {
  PHONE
  EMAIL
  OTHER
}

enum OrderType {
  RENTAL
  SALE
}

enum OrderChannel {
  CRM
  WEBSITE
  PHONE
  WHATSAPP
  INSTAGRAM
  OTHER
  IMPORT
  API
}

enum OrderStatus {
  DRAFT
  PENDING_CONFIRMATION
  RESERVED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PARTIALLY_ISSUED
  ISSUED
  PARTIALLY_RETURNED
  RETURNED
  COMPLETED
  EXPIRED
  CANCELLED
  NO_SHOW
}

enum OrderItemStatus {
  DRAFT
  RESERVED
  PARTIALLY_ISSUED
  ISSUED
  PARTIALLY_RETURNED
  RETURNED
  COMPLETED
  CANCELLED
}

enum AllocationStatus {
  ACTIVE
  FULFILLED
  RELEASED
  CANCELLED
}

enum AllocationSourceType {
  ORDER
  MAINTENANCE
  TRANSFER
  MANUAL_BLOCK
}

model Organization {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  slug            String             @unique
  status          OrganizationStatus @default(ACTIVE)
  defaultCurrency String             @default("KZT") @map("default_currency") @db.Char(3)
  timezone        String             @default("UTC")
  defaultLocale   String             @default("en") @map("default_locale")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings                 OrganizationSettings?
  branches                 Branch[]
  locations                Location[]
  memberships              OrganizationMembership[]
  categories               Category[]
  sizes                    Size[]
  products                 Product[]
  productVariants          ProductVariant[]
  productPrices            ProductPrice[]
  productImages            ProductImage[]
  productInstances         ProductInstance[]
  instanceStatusHistory    InstanceStatusHistory[]
  instanceConditionHistory InstanceConditionHistory[]
  customers                Customer[]
  customerContacts         CustomerContact[]
  orders                   Order[]
  orderItems               OrderItem[]
  stockLevels              StockLevel[]
  capacityAllocations      CapacityAllocation[]
  orderEvents              OrderEvent[]
  authSessions             AuthSession[]
  inventoryCounter         InventoryCounter?
  stockAdjustments         StockAdjustment[]
  customerCounter          CustomerCounter?
  customerAddresses        CustomerAddress[]
  customerNotes            CustomerNote[]
  customerImportBatches    CustomerImportBatch[]
  orderCounter             OrderCounter?

  @@map("organizations")
}

model OrganizationSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationId            String   @unique @map("organization_id") @db.Uuid
  defaultRentalDurationDays Int?     @map("default_rental_duration_days")
  preparationBufferMinutes  Int      @default(0) @map("preparation_buffer_minutes")
  returnBufferMinutes       Int      @default(0) @map("return_buffer_minutes")
  turnaroundBufferMinutes   Int      @default(0) @map("turnaround_buffer_minutes")
  requireDeposit            Boolean  @default(false) @map("require_deposit")
  barcodePrefix             String?  @map("barcode_prefix")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  code           String
  city           String
  address        String?
  phone          String?
  timezone       String
  status         BranchStatus @default(ACTIVE)
  isPublic       Boolean      @default(false) @map("is_public")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locations           Location[]
  defaultMemberships  OrganizationMembership[]
  currentInstances    ProductInstance[]        @relation("CurrentBranch")
  homeInstances       ProductInstance[]        @relation("HomeBranch")
  prices              ProductPrice[]
  orders              Order[]
  stockLevels         StockLevel[]
  capacityAllocations CapacityAllocation[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("branches")
}

model Location {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  branchId         String       @map("branch_id") @db.Uuid
  parentLocationId String?      @map("parent_location_id") @db.Uuid
  name             String
  code             String
  type             LocationType
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parent       Location?         @relation("LocationTree", fields: [parentLocationId], references: [id], onDelete: Restrict)
  children     Location[]        @relation("LocationTree")
  instances    ProductInstance[]
  stockLevels  StockLevel[]

  @@unique([organizationId, code])
  @@index([organizationId, branchId, type])
  @@map("locations")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  phone        String?    @unique
  displayName  String     @map("display_name")
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships           OrganizationMembership[]
  assignedAllocations   CapacityAllocation[]       @relation("AllocationAssignee")
  stockAdjustments      StockAdjustment[]
  createdOrders         Order[]                    @relation("OrderCreator")
  orderEvents           OrderEvent[]
  statusChanges         InstanceStatusHistory[]
  conditionInspections  InstanceConditionHistory[]
  authSessions          AuthSession[]
  createdCustomers      Customer[]                 @relation("CustomerCreator")
  customerNotes         CustomerNote[]
  customerImportBatches CustomerImportBatch[]

  @@map("users")
}

model OrganizationMembership {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  defaultBranchId String?          @map("default_branch_id") @db.Uuid
  role            MembershipRole   @default(SELLER)
  status          MembershipStatus @default(INVITED)
  joinedAt        DateTime?        @map("joined_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultBranch Branch?       @relation(fields: [defaultBranchId], references: [id], onDelete: SetNull)
  authSessions  AuthSession[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model AuthSession {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  membershipId   String    @map("membership_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([membershipId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("auth_sessions")
}

model Category {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  parentId       String?           @map("parent_id") @db.Uuid
  name           String
  slug           String
  status         PublicationStatus @default(ACTIVE)
  sortOrder      Int               @default(0) @map("sort_order")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]   @relation("CategoryTree")
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("categories")
}

model Size {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  sizeSystem     String?  @map("size_system")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  variants     ProductVariant[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("sizes")
}

model Product {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @map("organization_id") @db.Uuid
  categoryId              String?               @map("category_id") @db.Uuid
  name                    String
  internalCode            String                @map("internal_code")
  supplierModel           String?               @map("supplier_model")
  description             String?
  brand                   String?
  color                   String?
  isRentable              Boolean               @default(true) @map("is_rentable")
  isSellable              Boolean               @default(true) @map("is_sellable")
  trackingMode            InventoryTrackingMode @default(SERIALIZED) @map("tracking_mode")
  turnaroundBufferMinutes Int?                  @map("turnaround_buffer_minutes")
  publicationStatus       PublicationStatus     @default(DRAFT) @map("publication_status")
  archivedAt              DateTime?             @map("archived_at") @db.Timestamptz(3)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  images       ProductImage[]

  @@unique([organizationId, internalCode])
  @@index([organizationId, publicationStatus])
  @@index([organizationId, categoryId])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sizeId         String   @map("size_id") @db.Uuid
  sku            String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  size                Size                 @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  prices              ProductPrice[]
  images              ProductImage[]
  instances           ProductInstance[]
  orderItems          OrderItem[]
  stockLevels         StockLevel[]
  capacityAllocations CapacityAllocation[]

  @@unique([organizationId, sku])
  @@unique([productId, sizeId])
  @@index([organizationId, productId, isActive])
  @@map("product_variants")
}

model ProductPrice {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  productVariantId String    @map("product_variant_id") @db.Uuid
  branchId         String?   @map("branch_id") @db.Uuid
  type             PriceType
  amountMinor      BigInt    @map("amount_minor")
  currency         String    @db.Char(3)
  validFrom        DateTime  @map("valid_from") @db.Timestamptz(3)
  validUntil       DateTime? @map("valid_until") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([organizationId, productVariantId, type, validFrom])
  @@map("product_prices")
}

model ProductImage {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  productId        String             @map("product_id") @db.Uuid
  productVariantId String?            @map("product_variant_id") @db.Uuid
  storageKey       String             @map("storage_key")
  mimeType         String             @map("mime_type")
  width            Int?
  height           Int?
  sortOrder        Int                @default(0) @map("sort_order")
  isPrimary        Boolean            @default(false) @map("is_primary")
  altText          String?            @map("alt_text")
  status           ProductImageStatus @default(ACTIVE)
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([organizationId, storageKey])
  @@index([organizationId, productId, sortOrder])
  @@map("product_images")
}

model ProductInstance {
  id                String                           @id @default(uuid()) @db.Uuid
  organizationId    String                           @map("organization_id") @db.Uuid
  productVariantId  String                           @map("product_variant_id") @db.Uuid
  inventoryNumber   String                           @map("inventory_number")
  barcode           String
  operationalStatus ProductInstanceOperationalStatus @default(AVAILABLE) @map("operational_status")
  conditionStatus   ProductInstanceCondition         @default(GOOD) @map("condition_status")
  homeBranchId      String                           @map("home_branch_id") @db.Uuid
  currentBranchId   String                           @map("current_branch_id") @db.Uuid
  currentLocationId String                           @map("current_location_id") @db.Uuid
  acquiredAt        DateTime?                        @map("acquired_at") @db.Timestamptz(3)
  purchaseCostMinor BigInt?                          @map("purchase_cost_minor")
  currency          String?                          @db.Char(3)
  notes             String?
  version           Int                              @default(1)
  retiredAt         DateTime?                        @map("retired_at") @db.Timestamptz(3)
  createdAt         DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productVariant      ProductVariant             @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  homeBranch          Branch                     @relation("HomeBranch", fields: [homeBranchId], references: [id], onDelete: Restrict)
  currentBranch       Branch                     @relation("CurrentBranch", fields: [currentBranchId], references: [id], onDelete: Restrict)
  currentLocation     Location                   @relation(fields: [currentLocationId], references: [id], onDelete: Restrict)
  statusHistory       InstanceStatusHistory[]
  conditionHistory    InstanceConditionHistory[]
  capacityAllocations CapacityAllocation[]

  @@unique([organizationId, inventoryNumber])
  @@unique([organizationId, barcode])
  @@index([organizationId, productVariantId, operationalStatus])
  @@index([organizationId, currentBranchId, currentLocationId])
  @@map("product_instances")
}

model InstanceStatusHistory {
  id                String                            @id @default(uuid()) @db.Uuid
  organizationId    String                            @map("organization_id") @db.Uuid
  productInstanceId String                            @map("product_instance_id") @db.Uuid
  fromStatus        ProductInstanceOperationalStatus? @map("from_status")
  toStatus          ProductInstanceOperationalStatus  @map("to_status")
  reason            String?
  sourceType        String?                           @map("source_type")
  sourceId          String?                           @map("source_id") @db.Uuid
  changedByUserId   String?                           @map("changed_by_user_id") @db.Uuid
  changedAt         DateTime                          @default(now()) @map("changed_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productInstance ProductInstance @relation(fields: [productInstanceId], references: [id], onDelete: Restrict)
  changedBy       User?           @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, productInstanceId, changedAt])
  @@map("instance_status_history")
}

model InstanceConditionHistory {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @map("organization_id") @db.Uuid
  productInstanceId String                   @map("product_instance_id") @db.Uuid
  conditionStatus   ProductInstanceCondition @map("condition_status")
  description       String?
  inspectionType    String?                  @map("inspection_type")
  inspectedByUserId String?                  @map("inspected_by_user_id") @db.Uuid
  inspectedAt       DateTime                 @default(now()) @map("inspected_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productInstance ProductInstance @relation(fields: [productInstanceId], references: [id], onDelete: Restrict)
  inspectedBy     User?           @relation(fields: [inspectedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, productInstanceId, inspectedAt])
  @@map("instance_condition_history")
}

model Customer {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  customerNumber    String         @map("customer_number")
  firstName         String         @map("first_name")
  lastName          String?        @map("last_name")
  middleName        String?        @map("middle_name")
  birthDate         DateTime?      @map("birth_date") @db.Date
  preferredLanguage String?        @map("preferred_language")
  status            CustomerStatus @default(ACTIVE)
  source            String?
  marketingConsent  Boolean        @default(false) @map("marketing_consent")
  createdByUserId   String?        @map("created_by_user_id") @db.Uuid
  archivedAt        DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?             @relation("CustomerCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  contacts     CustomerContact[]
  addresses    CustomerAddress[]
  notes        CustomerNote[]
  orders       Order[]

  @@unique([organizationId, customerNumber])
  @@index([organizationId, status])
  @@map("customers")
}

model CustomerContact {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  customerId      String      @map("customer_id") @db.Uuid
  type            ContactType
  value           String
  normalizedValue String      @map("normalized_value")
  isPrimary       Boolean     @default(false) @map("is_primary")
  isVerified      Boolean     @default(false) @map("is_verified")
  label           String?
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, normalizedValue])
  @@index([organizationId, customerId])
  @@map("customer_contacts")
}

model CustomerCounter {
  organizationId String       @id @map("organization_id") @db.Uuid
  nextValue      BigInt       @default(1) @map("next_value")
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("customer_counters")
}

model CustomerAddress {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  type           String       @default("OTHER")
  country        String?
  city           String?
  addressLine    String       @map("address_line")
  comment        String?
  isPrimary      Boolean      @default(false) @map("is_primary")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@map("customer_addresses")
}

model CustomerNote {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  customerId      String       @map("customer_id") @db.Uuid
  text            String
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId, createdAt])
  @@map("customer_notes")
}

model CustomerImportBatch {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  createdByUserId  String?      @map("created_by_user_id") @db.Uuid
  originalFilename String       @map("original_filename")
  status           String       @default("UPLOADED")
  rawRows          Json         @map("raw_rows")
  mapping          Json?
  analysis         Json?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime     @map("expires_at") @db.Timestamptz(3)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(3)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, expiresAt])
  @@map("customer_import_batches")
}

model Order {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  orderNumber          String       @map("order_number")
  branchId             String       @map("branch_id") @db.Uuid
  customerId           String       @map("customer_id") @db.Uuid
  type                 OrderType
  channel              OrderChannel
  status               OrderStatus  @default(DRAFT)
  currency             String       @db.Char(3)
  rentalStartAt        DateTime?    @map("rental_start_at") @db.Timestamptz(3)
  rentalEndAt          DateTime?    @map("rental_end_at") @db.Timestamptz(3)
  expectedReturnAt     DateTime?    @map("expected_return_at") @db.Timestamptz(3)
  subtotalMinor        BigInt       @default(0) @map("subtotal_minor")
  discountTotalMinor   BigInt       @default(0) @map("discount_total_minor")
  totalMinor           BigInt       @default(0) @map("total_minor")
  depositRequiredMinor BigInt       @default(0) @map("deposit_required_minor")
  paidTotalMinor       BigInt       @default(0) @map("paid_total_minor")
  balanceDueMinor      BigInt       @default(0) @map("balance_due_minor")
  customerComment      String?      @map("customer_comment")
  internalComment      String?      @map("internal_comment")
  expiresAt            DateTime?    @map("expires_at") @db.Timestamptz(3)
  confirmedAt          DateTime?    @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt          DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason   String?      @map("cancellation_reason")
  completedAt          DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdByUserId      String?      @map("created_by_user_id") @db.Uuid
  version              Int          @default(1)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy           User?                @relation("OrderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  capacityAllocations CapacityAllocation[]
  events              OrderEvent[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, branchId, status])
  @@index([organizationId, customerId, createdAt])
  @@map("orders")
}

model OrderCounter {
  organizationId String   @id @map("organization_id") @db.Uuid
  nextValue      BigInt   @default(1) @map("next_value")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("order_counters")
}

model OrderItem {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  productVariantId    String          @map("product_variant_id") @db.Uuid
  quantity            Int
  status              OrderItemStatus @default(DRAFT)
  rentalStartAt       DateTime?       @map("rental_start_at") @db.Timestamptz(3)
  rentalEndAt         DateTime?       @map("rental_end_at") @db.Timestamptz(3)
  unitPriceMinor      BigInt          @map("unit_price_minor")
  discountTotalMinor  BigInt          @default(0) @map("discount_total_minor")
  lineTotalMinor      BigInt          @map("line_total_minor")
  currency            String          @db.Char(3)
  productNameSnapshot String          @map("product_name_snapshot")
  variantNameSnapshot String          @map("variant_name_snapshot")
  skuSnapshot         String          @map("sku_snapshot")
  notes               String?
  adjustmentReason    String?         @map("adjustment_reason")
  removedAt           DateTime?       @map("removed_at") @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariant      ProductVariant       @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  capacityAllocations CapacityAllocation[]

  @@index([organizationId, orderId])
  @@index([organizationId, orderId, removedAt])
  @@index([organizationId, productVariantId])
  @@map("order_items")
}

model StockLevel {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  locationId       String?  @map("location_id") @db.Uuid
  quantity         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productVariant ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  location       Location?         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  adjustments    StockAdjustment[]

  @@index([organizationId, productVariantId, branchId])
  @@map("stock_levels")
}

model InventoryCounter {
  organizationId String   @id @map("organization_id") @db.Uuid
  nextValue      BigInt   @default(1) @map("next_value")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("inventory_counters")
}

model StockAdjustment {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  stockLevelId      String              @map("stock_level_id") @db.Uuid
  type              StockAdjustmentType
  delta             Int
  resultingQuantity Int                 @map("resulting_quantity")
  reason            String
  createdByUserId   String?             @map("created_by_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stockLevel   StockLevel   @relation(fields: [stockLevelId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, stockLevelId, createdAt])
  @@map("stock_adjustments")
}

model CapacityAllocation {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  orderId           String?              @map("order_id") @db.Uuid
  orderItemId       String?              @map("order_item_id") @db.Uuid
  productVariantId  String               @map("product_variant_id") @db.Uuid
  productInstanceId String?              @map("product_instance_id") @db.Uuid
  branchId          String               @map("branch_id") @db.Uuid
  quantity          Int                  @default(1)
  sourceType        AllocationSourceType @default(ORDER) @map("source_type")
  sourceReferenceId String?              @map("source_reference_id") @db.Uuid
  blockedFrom       DateTime             @map("blocked_from") @db.Timestamptz(3)
  blockedUntil      DateTime?            @map("blocked_until") @db.Timestamptz(3)
  status            AllocationStatus     @default(ACTIVE)
  assignedAt        DateTime             @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedByUserId  String?              @map("assigned_by_user_id") @db.Uuid
  releasedAt        DateTime?            @map("released_at") @db.Timestamptz(3)
  releaseReason     String?              @map("release_reason")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem       OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productVariant  ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  productInstance ProductInstance? @relation(fields: [productInstanceId], references: [id], onDelete: Restrict)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedBy      User?            @relation("AllocationAssignee", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, productInstanceId, blockedFrom, blockedUntil])
  @@index([organizationId, productVariantId, branchId, blockedFrom, blockedUntil])
  @@index([organizationId, orderId, status])
  @@map("capacity_allocations")
}

model OrderEvent {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  eventType       String       @map("event_type")
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus? @map("to_status")
  payload         Json?
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, orderId, createdAt])
  @@map("order_events")
}
